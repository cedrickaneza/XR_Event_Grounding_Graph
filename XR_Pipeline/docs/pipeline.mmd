flowchart TD
    %% ── INPUT ──────────────────────────────────────────
    CAP(["`**Quest 3 Capture**
    RGB frames · Depth frames · Pose data`"])

    %% ── STAGE 0 : SETUP ────────────────────────────────
    S00["**00** bootstrap_repo
    Create folder structure & configs"]

    %% ── STAGE 1 : INGEST ───────────────────────────────
    S01["**01** build_frame_manifest
    Scan capture → frame_manifest.csv"]
    S02["**02** validate_manifest
    Check completeness & pose plausibility"]
    S03["**03** visualize_rgb_depth_pose
    RGB+depth overlays · pose trajectory"]

    FM[(frame_manifest.csv)]

    %% ── STAGE 2 : DETECTION ────────────────────────────
    S04["**04** ingest_spatialobjects
    Legacy passthrough"]
    S05["**05** build_object_observations
    Grounding DINO → 3D backprojection"]

    OO[(object_observations.csv)]

    %% ── STAGE 3 : TRACKING ─────────────────────────────
    S06["**06** link_object_tracks
    Associate detections across frames"]

    OT[(object_tracks.csv)]

    %% ── STAGE 4 : EVENTS ───────────────────────────────
    S07["**07** build_event_windows
    Detect motion & activity bursts"]
    S08["**08** generate_event_summaries
    Add summaries & semantic roles"]

    EW[(event_windows.csv)]
    EV[(events.csv)]
    ER[(event_object_roles.csv)]

    %% ── STAGE 5A : EGG GRAPH ───────────────────────────
    S09["**09** build_egg_graph
    Assemble Event-Grounding Graph"]

    EGG[(egg_graph.json)]

    %% ── STAGE 5B : SCENE STATE PACKAGE ─────────────────
    S09B["**09b** build_scene_state_package
    Normalise all outputs into reasoning contract"]

    SSP[("scene_state_package.json
    entities · relations · hypotheses
    observations · provenance · constraints")]

    %% ── STAGE 6A : OPERATION EVENTS ────────────────────
    S10B["**10b** build_operation_events
    PICK_UP · PUT_DOWN · HOLD · CONTACT
    PLACE_ONTO · INSERT · ATTACH candidates"]

    OPE[(operation_events.csv)]
    SUPST[(support_state_transitions.csv)]

    %% ── STAGE 6B : STATE FACTS ──────────────────────────
    S09C["**09c** build_state_facts
    holding · released · co_held · on_surface
    time-scoped symbolic predicates"]

    SF[("state_facts.json / .csv")]

    %% ── STAGE 6C : WORKFLOW TIMELINE ───────────────────
    S10C["**10c** build_workflow_timeline
    Cluster operations into
    manipulation · hold · placement · idle phases"]

    WFT[("workflow_timeline.json / .csv")]

    %% ── STAGE 6D : SUBTASK EVENTS ──────────────────────
    S10D["**10d** build_subtask_events
    pick_up_part · insert_part · attach_part
    inferred from facts + operations + domain"]

    SUB[(subtask_events.csv)]
    SUBSEQ[(subtask_sequence.json)]

    %% ── STAGE 6E : ASSEMBLY GRAPH ───────────────────────
    S10E["**10e** build_assembly_graph
    Typed graph: objects · relation_facts
    subtasks · subgoals · phases · constraints"]

    AG[(assembly_graph.json)]

    %% ── STAGE 6F : ASSEMBLY STATE PACKAGE ──────────────
    S09D["**09d** build_assembly_state_package
    Integrate all assembly layer outputs
    into unified reasoning package"]

    ASP[("assembly_state_package.json")]

    %% ── STAGE 7A : OPERATION REVIEW ────────────────────
    S11["**11** build_operation_review
    Per-operation evidence · frame overlays
    timeline visualisation"]

    %% ── STAGE 7B : ASSEMBLY REVIEW ─────────────────────
    S11B["**11b** build_assembly_review
    Active step · achieved goals · blocked
    likely next · full evidence traces"]

    AR[("assembly_review.json / .md")]

    %% ── GRAPH OPS ──────────────────────────────────────
    S10["**10** prune_egg_graph
    NL query → pruned subgraph + answer"]
    S12["**12** demo_queries
    Demo Q&A over EGG graph"]

    %% ── NEO4J EXPORT ────────────────────────────────────
    S11E["**11e** export_neo4j_csv
    EGG → nodes.csv + relationships.csv"]
    S14["**14** import_neo4j
    Push CSVs into Neo4j Aura"]

    NEO4J[(Neo4j Aura)]

